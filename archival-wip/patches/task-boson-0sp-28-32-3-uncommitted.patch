+test('native reaction acknowledgements correlate by event before dispatch and reaction after dispatch', async () => {
+  const directory = await mkdtemp(join(tmpdir(), 'boson-reaction-bridge-'));
+  const socketPath = join(directory, 'village.sock');
+  const village = { stdin: new PassThrough(), stdout: new PassThrough() };
+  const bridge = createVillagePttIpcBridge({ socketPath, village });
+  try {
+    await bridge.start();
+    const commands = [
+      { version: 1, type: 'ptt.reaction.ack', eventId: 'event-00000001', residentId: 'mira', status: 'unavailable', at: Date.now() },
+      { version: 1, type: 'ptt.reaction.ack', reactionId: 'reaction-00000002', eventId: 'event-00000002', residentId: 'pip', status: 'accepted', at: Date.now() },
+    ];
+    for (const command of commands) {
+      const responsePromise = new Promise((resolve, reject) => {
+        const socket = createConnection(socketPath);
+        socket.once('error', reject);
+        socket.once('data', (data) => resolve(JSON.parse(String(data))));
+        socket.write(`${JSON.stringify(command)}\n`);
+      });
+      const forwarded = await new Promise((resolve) => village.stdin.once('data', (data) => resolve(JSON.parse(String(data)))));
+      assert.deepEqual(forwarded, command);
+      const { at: _at, ...correlation } = command;
+      const acknowledgement = { version: 1, ...correlation };
+      assert.equal(bridge.deliverAck(acknowledgement), true);
+      assert.deepEqual(await responsePromise, acknowledgement);
+    }
+  } finally {
+    bridge.close();
+    village.stdin.destroy(); village.stdout.destroy();
+    await rm(directory, { recursive: true, force: true });
+  }
+});
+
+test('pre-dispatch unavailable ACKs for one event stay isolated per resident', async () => {
+  const directory = await mkdtemp(join(tmpdir(), 'boson-reaction-recipient-bridge-'));
+  const socketPath = join(directory, 'village.sock');
+  const village = { stdin: new PassThrough(), stdout: new PassThrough() };
+  const bridge = createVillagePttIpcBridge({ socketPath, village });
+  try {
+    await bridge.start();
+    const commands = ['mira', 'pip'].map((residentId) => ({ version: 1, type: 'ptt.reaction.ack',
+      eventId: 'heard-event-123', residentId, status: 'unavailable', at: Date.now() }));
+    const pending = commands.map((command) => new Promise((resolve, reject) => {
+      const socket = createConnection(socketPath);
+      socket.once('error', reject);
+      socket.once('data', (data) => resolve(JSON.parse(String(data))));
+      socket.write(`${JSON.stringify(command)}\n`);
+    }));
+    const forwarded = new Set();
+    while (forwarded.size < commands.length) {
+      const command = await new Promise((resolve) => village.stdin.once('data', (data) => resolve(JSON.parse(String(data)))));
+      forwarded.add(command.residentId);
+    }
+    for (const command of [...commands].reverse()) {
+      const acknowledgement = { version: 1, type: 'ptt.reaction.ack', eventId: command.eventId,
+        residentId: command.residentId, status: 'unavailable' };
+      assert.equal(bridge.deliverAck(acknowledgement), true);
+    }
+    const results = await Promise.all(pending);
+    assert.deepEqual(results.map(({ residentId, status }) => ({ residentId, status })),
+      commands.map(({ residentId, status }) => ({ residentId, status })));
+  } finally {
+    bridge.close();
+    village.stdin.destroy(); village.stdout.destroy();
