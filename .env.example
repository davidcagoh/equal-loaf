# Copy to .env and replace this placeholder with your own key to enable native voice.
BOSON_API_KEY=YOUR_BOSON_API_KEY_HERE

# Optional launcher overrides. Defaults: DemoPlayer, ports 3000/3001, cached world directory.
# BOSON_MC_PLAYER=DemoPlayer
# BOSON_EXPLORER_VIEWER_PORT=3000
# BOSON_COMPANION_VIEWER_PORT=3001
# BOSON_MC_DIR=/path/to/minecraft-1.21.11
